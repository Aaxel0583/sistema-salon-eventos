# =====================================================================
# Archivo de configuración de la instalación (DA-06, RD-06, RNF-07, RNF-17)
# 1. Copia este archivo como .env
# 2. Llena los valores reales
# 3. NUNCA subas .env al repositorio (ya está en .gitignore)
# =====================================================================

# Nombre comercial que se muestra en la barra superior y en el título.
NOMBRE_NEGOCIO=Salón de Eventos

# Cadena de conexión de PostgreSQL. En Neon cópiala desde
# Dashboard > Connection string (debe terminar en ?sslmode=require).
DATABASE_URL=postgresql://usuario:clave@host/basedatos?sslmode=require

# Llave para firmar la sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-llave-larga-y-aleatoria

# 1 en producción (HTTPS). 0 en desarrollo local (http://127.0.0.1).
COOKIE_SEGURA=0

# Tamaño del pool de conexiones. El nivel gratuito de Neon tolera pocas.
POOL_MIN=1
POOL_MAX=5

# Solo para pruebas automáticas de integración (base desechable).
# TEST_DATABASE_URL=postgresql://usuario:clave@localhost/salon_test
